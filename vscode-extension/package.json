{
    "name": "browser-bridge",
    "displayName": "Browser Bridge",
    "description": "Connect your AI IDE to browsers for real-time debugging and control",
    "version": "1.3.1b",
    "publisher": "sad1kul",
    "author": {
        "name": "Sadikul Islam"
    },
    "license": "MIT",
    "private": true,
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Debuggers",
        "Other"
    ],
    "keywords": [
        "browser",
        "chrome",
        "brave",
        "debugging",
        "MCP",
        "AI"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "browserbridge.showMenu",
                "title": "Browser Bridge: Show Menu",
                "icon": "$(globe)"
            },
            {
                "command": "browserbridge.startServer",
                "title": "Browser Bridge: Start Server"
            },
            {
                "command": "browserbridge.stopServer",
                "title": "Browser Bridge: Stop Server"
            },
            {
                "command": "browserbridge.restartServer",
                "title": "Browser Bridge: Restart Server"
            },
            {
                "command": "browserbridge.selectBrowser",
                "title": "Browser Bridge: Select Browser"
            }
        ],
        "configuration": {
            "title": "Browser Bridge",
            "properties": {
                "browserbridge.pythonPath": {
                    "type": "string",
                    "default": "python3",
                    "description": "Path to Python interpreter"
                },
                "browserbridge.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to bridge_server.py (leave empty for auto-detect)"
                },
                "browserbridge.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically start Bridge Server on IDE startup"
                }
            }
        }
    }
}