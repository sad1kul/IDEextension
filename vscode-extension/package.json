{
    "name": "browser-bridge",
    "displayName": "Browser Bridge",
    "description": "Connect your AI IDE to Chrome browser for real-time debugging, DOM inspection, and remote browser control",
    "version": "1.0.0",
    "publisher": "sadikulislam",
    "author": {
        "name": "Sadikul Islam"
    },
    "license": "MIT",
    "private": true,
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Debuggers",
        "Other"
    ],
    "keywords": [
        "browser",
        "chrome",
        "debugging",
        "MCP",
        "AI",
        "IDE",
        "websocket"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "browserbridge.setup",
                "title": "Browser Bridge: Setup"
            },
            {
                "command": "browserbridge.startServer",
                "title": "Browser Bridge: Start Server"
            },
            {
                "command": "browserbridge.stopServer",
                "title": "Browser Bridge: Stop Server"
            },
            {
                "command": "browserbridge.status",
                "title": "Browser Bridge: Check Status"
            }
        ],
        "configuration": {
            "title": "Browser Bridge",
            "properties": {
                "browserbridge.chromeExtensionId": {
                    "type": "string",
                    "default": "",
                    "description": "Chrome Extension ID for the Browser Bridge connector"
                },
                "browserbridge.pythonPath": {
                    "type": "string",
                    "default": "python3",
                    "description": "Path to Python interpreter"
                },
                "browserbridge.autoStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically start Bridge Server when VS Code opens"
                }
            }
        }
    },
    "dependencies": {
        "@vscode/vsce": "^3.7.1"
    }
}
